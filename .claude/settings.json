{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(.claude/skills/electron-emulator/scripts/emu.py *)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-na-wijziging.sh"
          }
        ]
      }
    ]
  }
}
